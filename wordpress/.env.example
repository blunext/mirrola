# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Salts: 8 random strings, e.g. `openssl rand -base64 48` for each.

# MariaDB
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# WordPress (read by wp-config.php through getenv)
WORDPRESS_DB_HOST=          # the db service, e.g. db or db:3306
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=
WORDPRESS_DB_NAME=

# WordPress keys and salts
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# restic backups (wordpress/snapshot.sh, make snapshot) to the Cloudflare R2
# bucket "olamundo". The password is `openssl rand -hex 32`; keep it and the
# R2 token in the password manager, without the password the snapshots can't
# be read. No quotes. New repository: make snapshot-init
# RESTIC_REPOSITORY: s3:https://<account-id>.r2.cloudflarestorage.com/olamundo
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# R2 API token (Object Read & Write, only bucket "olamundo")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
